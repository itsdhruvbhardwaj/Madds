OPENAI_API_KEY=
IMAGE_GENERATION_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=qwen/qwen-image-2.1-turbo
OPENROUTER_IMAGE_RESOLUTION=1K
OPENROUTER_IMAGE_ASPECT_RATIO=2:3
PORT=5000
CLIENT_ORIGIN=
# Comma-separated verified PicMee account emails allowed to manage styles.
ADMIN_EMAILS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
# Configure Google ADC with a service account authorized for the Android Publisher API.
GOOGLE_APPLICATION_CREDENTIALS=
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5000
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_TIMEOUT_MS=120000

# Required to enable rewarded ads; leave unset until AdMob is configured.
ADMOB_REWARDED_AD_UNIT_ID=
ADMOB_REWARDED_AD_REWARD_ITEM=Reward
ADMOB_REWARDED_AD_REWARD_AMOUNT=1
REWARDED_AD_CREDITS=1
REWARDED_AD_ATTEMPT_TTL_SECONDS=3600
ADMOB_SSV_MAX_CALLBACK_AGE_SECONDS=86400
ADMOB_SSV_MAX_FUTURE_SKEW_SECONDS=300
